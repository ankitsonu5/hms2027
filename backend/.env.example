# Copy to backend/.env on the server and fill in real values.
# backend/.env is gitignored — it never comes down with `git pull`.

# ── Mode ─────────────────────────────────────────────────────────────────────
# production: Swagger off, TypeORM `synchronize` OFF.
# There are no migrations yet, so with `production` the tables must already
# exist (restore a pg_dump first). For a brand-new empty database, boot once
# with `development` so the tables get created, then switch to `production`.
NODE_ENV=production

# ── App ──────────────────────────────────────────────────────────────────────
# PORT is set in ecosystem.config.js (4045) and PM2's env takes precedence.
# Only set it here if you run `node dist/main.js` without PM2.
# PORT=4045

# Frontend and API are served from the same origin, so CORS is not needed.
# CORS_ORIGIN=

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=hmsadmin
DB_PASSWORD=change-me
DB_NAME=hms_db

# ── JWT — generate fresh secrets on the server: openssl rand -hex 32 ─────────
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=./uploads
